  recipient_municipality_code String?

  total_amount BigInt @default(0)
  service_amount  BigInt @default(0)
  products_amount BigInt @default(0)
  iss_amount      BigInt @default(0)
  iss_rate        Decimal? @db.Decimal(5, 2)
  irrf_amount     BigInt @default(0)
  inss_amount     BigInt @default(0)
  pis_amount      BigInt @default(0)
  cofins_amount   BigInt @default(0)
  csll_amount     BigInt @default(0)
  icms_amount     BigInt @default(0)
  ipi_amount      BigInt @default(0)

  description     String? @db.Text
  service_code    String?
  cnae            String?
  cfop            String?
  cst             String?

  xml_content       String? @db.Text
  pdf_url           String? @db.Text
  provider_document_id String?
  raw_response      Json?

  matched_payable_id    String?
  matched_payable       AccountPayable? @relation("PayableFiscalDocs", fields: [matched_payable_id], references: [id])

  matched_receivable_id String?
  matched_receivable    AccountReceivable? @relation("ReceivableFiscalDocs", fields: [matched_receivable_id], references: [id])

  matched_at        DateTime?
  matched_by_user_id String?
  match_score       Int?

  notes      String? @db.Text

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  // Marca operacional ligada a esta nota (ex.: NFe da Pixbet pode ser
  // alocada a uma marca específica como BetDaSorte ou Pibet). Opcional —
  // notas podem ficar no nível da empresa sem marca.
  brand_id String?
  brand    Brand?  @relation("FiscalDocBrand", fields: [brand_id], references: [id])

  // Confirmação manual: quando preenchido, a nota foi conferida e teve uma
  // AccountPayable criada/vinculada. Notas com confirmed_at=NULL ficam na
  // "caixa de entrada" aguardando seleção de marca + clique em Confirmar.
  confirmed_at      DateTime?
  confirmed_by_user_id String?

  provider_id String
  provider    FiscalProvider @relation(fields: [provider_id], references: [id])

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  metadeleted Boolean  @default(false)

  @@index([metadeleted])
  @@index([company_id])
  @@index([brand_id])
  @@index([document_type])
  @@index([direction])
  @@index([status])
  @@index([confirmed_at])
  @@index([issue_date])
  @@index([issuer_cnpj])
  @@index([recipient_cnpj])
  @@index([matched_payable_id])
  @@index([matched_receivable_id])
  @@map("fiscal_documents")
}

model FiscalSyncLog {
  id String @id @default(cuid())

  sync_type     String
  start_date    DateTime?
  end_date      DateTime?

  status        String
  documents_fetched Int  @default(0)
  documents_created Int  @default(0)
  documents_updated Int  @default(0)
  error_message String?  @db.Text

  duration_ms   Int?

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  triggered_by_user_id String?

  created_at DateTime @default(now())

  @@index([company_id])
  @@index([created_at])
  @@map("fiscal_sync_logs")
}

/// Sessão Serpro Integra Contador (procurador eCAC).
/// Tabela com no máximo 1 linha (singleton) — só existe uma sessão de
/// procurador por instalação. Os tokens são armazenados criptografados
/// (AES-256-GCM via fiscal/crypto.helper) e cacheados em memória; esta
/// tabela existe apenas para sobreviver a restarts da API.
model SerproSession {
  id String @id @default(cuid())

  contratante_cnpj String
  encrypted_jwt_token       String @db.Text
  encrypted_access_token    String @db.Text
  expires_at DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("serpro_sessions")
}

/// Cache de protocolos SITFIS (para sobreviver a restarts da API).
/// SITFIS é assíncrono (Apoiar+Emitir) e Serpro retorna 304 quando você
/// solicita protocolo da mesma empresa em < 30min — exigindo reuso do
/// protocolo anterior.
model SerproSitfisProtocol {
  id String @id @default(cuid())

  contribuinte_cnpj String @unique
  protocolo_relatorio String @db.Text
  tempo_espera Int @default(0)

  cached_at DateTime @default(now())

  @@map("serpro_sitfis_protocols")
}

/// Parametrização global (escritório) das regras de lançamento contábil.
/// Cada event_key mapeia para débito/crédito (por código do plano padrão),
/// histórico Domínio e template de descrição. Substitui constantes hard-coded
/// em journal-posting.service.ts.
model AccountingRule {
  id String @id @default(cuid())

  event_key   String @unique
  group       String   // GGR_DAILY, PAYABLE_PAID, RECEIVABLE, TAX_APURATION
  label       String   // descrição legível em PT-BR
  description String?  @db.Text

  debit_code  String?  // ex: "1.1.1.01" — código do plano padrão
  credit_code String?

  historic_code     Int?     // código do histórico no Domínio (1-999)
  historic_template String?  @db.Text // ex: "Pagamento de {fornecedor} ref. {documento}"

  active   Boolean @default(true)

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  metadeleted Boolean  @default(false)

  @@index([group])
  @@map("accounting_rules")
}
