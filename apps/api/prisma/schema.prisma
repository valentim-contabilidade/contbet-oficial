model JournalEntry {
  id          String              @id @default(cuid())
  date        DateTime            @db.Date
  description String              @db.Text
  reference   String?
  source      JournalEntrySource  @default(MANUAL)
  source_id   String?

  total_amount BigInt              @default(0)
  posted       Boolean             @default(false)
  posted_at    DateTime?

  notes       String? @db.Text

  company_id String
  company    Company @relation(fields: [company_id], references: [id])
  brand_id   String?
  brand      Brand?  @relation(fields: [brand_id], references: [id])

  lines      JournalEntryLine[]

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  metadeleted Boolean  @default(false)

  @@index([metadeleted])
  @@index([company_id])
  @@index([brand_id])
  @@index([date])
  @@index([source, source_id])
  @@map("journal_entries")
}

model JournalEntryLine {
  id            String  @id @default(cuid())
  description   String? @db.Text
  debit_amount  BigInt  @default(0)
  credit_amount BigInt  @default(0)

  entry_id   String
  entry      JournalEntry @relation(fields: [entry_id], references: [id], onDelete: Cascade)

  account_id String
  account    ChartOfAccount @relation(fields: [account_id], references: [id])

  created_at DateTime @default(now())

  @@index([entry_id])
  @@index([account_id])
  @@map("journal_entry_lines")
}

model BankIntegration {
  id     String                  @id @default(cuid())
  type   BankIntegrationProvider @default(PLUGGY)

  client_id     String  @db.Text
  client_secret String  @db.Text  // criptografado
  sandbox_mode  Boolean @default(true)

  is_active    Boolean   @default(true)
  last_error   String?   @db.Text
  notes        String?   @db.Text

  company_id String  @unique
  company    Company @relation(fields: [company_id], references: [id])

  connections BankConnection[]

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  metadeleted Boolean  @default(false)

  @@index([metadeleted])
  @@index([company_id])
  @@map("bank_integrations")
}

model BankConnection {
  id String @id @default(cuid())

  // ID do "item" no provedor (no Pluggy: itemId; cada item agrega N contas)
  provider_item_id String
  // ID do conector (banco) usado pelo provedor
  provider_connector_id String?
  // Nome do banco apresentado pelo provedor (Itaú, Bradesco, etc.)
  institution_name String?
  // URL do logo do banco
  institution_logo String? @db.Text

  status        BankConnectionStatus @default(ACTIVE)
  status_detail String?              @db.Text

  last_sync_at      DateTime?
  next_auto_sync_at DateTime?
  last_error        String? @db.Text

  // Dados raw do último estado retornado (JSON)
  raw_meta Json?

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  integration_id String
  integration    BankIntegration @relation(fields: [integration_id], references: [id])

  bank_accounts BankAccount[]

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  metadeleted Boolean  @default(false)

  @@unique([integration_id, provider_item_id])
  @@index([metadeleted])
  @@index([company_id])
  @@index([status])
  @@map("bank_connections")
}

model FiscalProvider {
  id     String              @id @default(cuid())
  type   FiscalProviderType  @default(PLUGNOTAS)

  api_key       String  @db.Text
  api_secret    String? @db.Text
  base_url      String? @db.Text
  sandbox_mode  Boolean @default(false)

  is_active     Boolean   @default(true)
  last_sync_at  DateTime?
  last_error    String?   @db.Text

  auto_sync_enabled  Boolean @default(true)
  auto_sync_period   Int     @default(24)

  // ==== Configuração para EMISSÃO de NFSe (saída) ====
  issue_codigo_servico       String?  // ex.: "17.06"
  issue_cnae                 String?
  issue_inscricao_municipal  String?
  issue_iss_aliquota         Decimal? @db.Decimal(5, 2)
  issue_descricao_template   String?  @db.Text  // ex.: "Receita de operação de apostas - {data}"
  issue_tomador_cnpj         String?  // tomador padrão (se ausente, usa o próprio prestador)
  issue_tomador_razao_social String?

  notes String? @db.Text

  company_id String  @unique
  company    Company @relation(fields: [company_id], references: [id])

  certificates FiscalCertificate[]
  documents    FiscalDocument[]

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  metadeleted Boolean  @default(false)

  @@index([metadeleted])
  @@index([company_id])
  @@map("fiscal_providers")
}

model FiscalCertificate {
  id String @id @default(cuid())

  cnpj          String
  holder_name   String
  serial_number String?
  issuer        String?
  valid_from    DateTime
  valid_to      DateTime

  encrypted_pfx_base64 String  @db.Text
  encrypted_password   String  @db.Text

  status        FiscalCertificateStatus @default(ACTIVE)
  last_error    String?                  @db.Text

  provider_certificate_id String?
  uploaded_to_provider_at DateTime?

  notes String? @db.Text

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  provider_id String?
  provider    FiscalProvider? @relation(fields: [provider_id], references: [id])

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  metadeleted Boolean  @default(false)

  @@index([metadeleted])
  @@index([company_id])
  @@index([cnpj])
  @@index([status])
  @@map("fiscal_certificates")
}

model FiscalDocument {
  id String @id @default(cuid())

  document_type FiscalDocumentType
  direction     FiscalDocumentDirection
  status        FiscalDocumentStatus

  access_key    String?  @unique
  document_number String?
  series        String?
  rps_number    String?
  rps_series    String?

  issue_date    DateTime
  authorization_date DateTime?
  cancellation_date DateTime?

  issuer_cnpj      String
  issuer_name      String
  issuer_municipality_code String?
  issuer_state     String? @db.VarChar(2)

  recipient_cnpj   String?
  recipient_name   String?
  recipient_municipality_code String?

  total_amount BigInt @default(0)
  service_amount  BigInt @default(0)
  products_amount BigInt @default(0)
  iss_amount      BigInt @default(0)
  iss_rate        Decimal? @db.Decimal(5, 2)
  irrf_amount     BigInt @default(0)
  inss_amount     BigInt @default(0)
  pis_amount      BigInt @default(0)
  cofins_amount   BigInt @default(0)
  csll_amount     BigInt @default(0)
  icms_amount     BigInt @default(0)
  ipi_amount      BigInt @default(0)

  description     String? @db.Text
  service_code    String?
  cnae            String?
  cfop            String?
  cst             String?

  xml_content       String? @db.Text
  pdf_url           String? @db.Text
  provider_document_id String?
  raw_response      Json?

  matched_payable_id    String?
  matched_payable       AccountPayable? @relation("PayableFiscalDocs", fields: [matched_payable_id], references: [id])

  matched_receivable_id String?
  matched_receivable    AccountReceivable? @relation("ReceivableFiscalDocs", fields: [matched_receivable_id], references: [id])

  matched_at        DateTime?
  matched_by_user_id String?
  match_score       Int?

  notes      String? @db.Text

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  provider_id String
  provider    FiscalProvider @relation(fields: [provider_id], references: [id])

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  metadeleted Boolean  @default(false)

  @@index([metadeleted])
  @@index([company_id])
  @@index([document_type])
  @@index([direction])
  @@index([status])
  @@index([issue_date])
  @@index([issuer_cnpj])
  @@index([recipient_cnpj])
  @@index([matched_payable_id])
  @@index([matched_receivable_id])
  @@map("fiscal_documents")
}

model FiscalSyncLog {
  id String @id @default(cuid())

  sync_type     String
  start_date    DateTime?
  end_date      DateTime?

  status        String
  documents_fetched Int  @default(0)
  documents_created Int  @default(0)
  documents_updated Int  @default(0)
  error_message String?  @db.Text

  duration_ms   Int?

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  triggered_by_user_id String?

  created_at DateTime @default(now())

  @@index([company_id])
  @@index([created_at])
  @@map("fiscal_sync_logs")
}
