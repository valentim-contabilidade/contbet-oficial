generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Profile {
  ADMIN
  MANAGER
  OWNER
}

enum Status {
  ACTIVE
  INACTIVE
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum BankAccountType {
  CHECKING
  SAVINGS
  PAYMENT
  PSP_GATEWAY
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  PARTIAL
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum ContactPersonType {
  INDIVIDUAL
  COMPANY
}

enum StatementStatus {
  PROCESSING
  RECONCILED
  PARTIAL
  UNRECONCILED
}

enum StatementLineStatus {
  UNMATCHED
  MATCHED
  IGNORED
  CREATED
}

enum StatementLineType {
  CREDIT
  DEBIT
}

enum GgrSourceType {
  CSV_UPLOAD
  XLSX_UPLOAD
  API_REST
  MANUAL
}

enum GgrApurationStatus {
  OPEN
  CLOSED
  PAID
}

enum DataSourceStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum TaxRegime {
  LUCRO_REAL
  LUCRO_PRESUMIDO
  SIMPLES_NACIONAL
}

enum PisCofinsRegime {
  CUMULATIVO
  NAO_CUMULATIVO
}

enum IrpjApurationPeriod {
  TRIMESTRAL
  ANUAL_ESTIMATIVA
}

enum IrpjApurationStatus {
  OPEN
  CLOSED
  PAID
}

enum LalurAdjustmentType {
  ADDITION
  EXCLUSION
}

enum TaxApurationStatus {
  OPEN
  CLOSED
  PAID
}

enum IssCalculationBase {
  GGR
  NGR
}

enum PayableSource {
  MANUAL
  FISCAL_IMPORT
  RECURRING
  PAYROLL
  TAX_APURATION
}

enum RevenueType {
  OPERATIONAL
  NON_OPERATIONAL
}

enum JournalEntrySource {
  MANUAL
  GGR_DAILY
  PAYABLE_PAID
  RECEIVABLE_RECEIVED
  TAX_APURATION
  PAYROLL
  ADJUSTMENT
}

enum FiscalDocumentType {
  NFSE
  NFE
  NFCE
  CTE
}

enum FiscalDocumentDirection {
  INCOMING
  OUTGOING
}

enum FiscalDocumentStatus {
  PENDING
  AUTHORIZED
  CANCELLED
  REJECTED
  ERROR
}

enum FiscalProviderType {
  PLUGNOTAS
  FOCUS_NFE
  NFE_IO
  ARQUIVEI
}

enum BankIntegrationProvider {
  PLUGGY
  BELVO
  KLAVI
}

enum BankConnectionStatus {
  ACTIVE
  WAITING_USER_INPUT
  UPDATING
  LOGIN_ERROR
  OUTDATED
  DISCONNECTED
  ERROR
}

enum AuditAlertLevel {
  OK
  WARNING
  CRITICAL
}

enum FiscalCertificateStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

// === NOVOS ENUMS para Natureza Contábil ===

// Onde a natureza aparece na DRE
enum DreSection {
  RECEITA_OPERACIONAL          // Receita Bruta
  DEDUCAO_RECEITA              // Deduções da Receita (impostos sobre receita, devoluções)
  CUSTO_OPERACIONAL            // Custos (prêmios, CMV)
  DESPESA_OPERACIONAL          // Despesas Operacionais (administrativas, comerciais, pessoal)
  DESPESA_NAO_OPERACIONAL      // Despesas Não Operacionais
  RECEITA_FINANCEIRA           // Receitas Financeiras
  DESPESA_FINANCEIRA           // Despesas Financeiras (juros, IOF)
  IMPOSTO_LUCRO                // IRPJ + CSLL
}

// Tipo da natureza: receita ou despesa
enum NatureType {
  RECEITA
  DESPESA
}

// =================== EMPRESAS, USUÁRIOS, MARCAS ===================

model Company {
  id          String   @id @default(cuid())
  name        String
  cnpj        String   @unique
  address     String?
  city        String
  state       String   @db.VarChar(2)
  logo        String?  @db.Text
  tax_regime  TaxRegime @default(LUCRO_REAL)
  // true = escritório contábil (a própria firma que opera o ContBet),
  // false = cliente operadora de apostas. Apenas 1 escritório por instalação.
  // Usado no fluxo AutenticaProcurador (cert A1 do escritório vira procurador eCAC).
  is_office_account Boolean @default(false)
  // true = empresa fictícia usada apenas como modelo de referência (plano de
  // contas modelo, configurações default). Não opera, não tem A1 nem clientes
  // reais. Fica oculta nas listagens normais.
  is_template Boolean @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  metadeleted Boolean  @default(false)

  users                User[]
  brands               Brand[]
  chart_of_accounts    ChartOfAccount[]
  financial_categories FinancialCategory[]
  financial_natures    FinancialNature[]
  bank_accounts        BankAccount[]
  accounts_payable     AccountPayable[]
  accounts_receivable  AccountReceivable[]
  transactions         Transaction[]
  contacts             Contact[]
  bank_statements      BankStatement[]
  ggr_records          GgrDailyRecord[]
  ggr_apurations       GgrMonthlyApuration[]
  data_sources         DataSource[]
  tax_config           CompanyTaxConfig?
  irpj_apurations      IrpjCsllApuration[]
  pis_cofins_apurations PisCofinsApuration[]
  iss_apurations       IssApuration[]
  lalur_adjustments    LalurAdjustment[]
  fiscal_provider      FiscalProvider?
  fiscal_certificates  FiscalCertificate[]
  fiscal_documents     FiscalDocument[]
  fiscal_sync_logs     FiscalSyncLog[]
  journal_entries      JournalEntry[]
  bank_integration     BankIntegration?
  bank_connections     BankConnection[]
  audit_movements_checks AuditMovementsCheck[]
  audit_fees_checks      AuditFeesCheck[]
  audit_taxes_checks     AuditTaxesCheck[]
  audit_alerts           AuditAlert[]

  @@index([metadeleted])
  @@map("companies")
}

model User {
  id            String    @id @default(cuid())
  name          String
  username      String    @unique
  email         String
  password_hash String
  profile       Profile
  status        Status    @default(ACTIVE)
  failed_logins Int       @default(0)
  locked_until  DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  metadeleted   Boolean   @default(false)

  company_id String?
  company    Company? @relation(fields: [company_id], references: [id])
  // brand_id: marca "primária" (compatibilidade com OWNER de marca única).
  // Para gestores com múltiplas marcas, use a tabela `brand_users` (N:N).
  brand_id   String?
  brand      Brand?   @relation(fields: [brand_id], references: [id])

  audit_logs        AuditLog[]
  brand_assignments BrandUser[]
  claim_attempts    FiscalClaimAttempt[]

  @@index([metadeleted])
  @@index([company_id])
  @@map("users")
}

/// Atribuição N:N entre usuário e marca, usada por gestores (OWNER) que
/// administram financeiramente múltiplas marcas. Quando vazia para um OWNER,
/// o sistema cai de volta para `User.brand_id` (compatibilidade retroativa).
model BrandUser {
  user_id    String
  brand_id   String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  brand      Brand    @relation(fields: [brand_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@id([user_id, brand_id])
  @@index([user_id])
  @@index([brand_id])
  @@map("brand_users")
}

/// Tentativas de reivindicação de NF (claim) — usadas para rate-limit
/// anti-fishing. Após 3 falhas em 10min, o usuário fica bloqueado por 3min
/// e precisa tentar com trio diferente (Nº + CNPJ + valor) antes de
/// reutilizar qualquer tentativa anterior.
model FiscalClaimAttempt {
  id                 String   @id @default(cuid())
  user_id            String
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  brand_id           String   // marca para a qual o gestor tentou
  document_number    String
  issuer_cnpj        String   // CNPJ normalizado (só dígitos)
  total_amount_cents BigInt
  success            Boolean
  failure_reason     String?  // NOT_FOUND, ALREADY_CLAIMED, MULTIPLE_MATCHES, INVALID_AMOUNT...
  attempted_at       DateTime @default(now())

  @@index([user_id, attempted_at])
  @@index([attempted_at])
  @@map("fiscal_claim_attempts")
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  domain      String?
  description String?  @db.Text
  status      Status   @default(ACTIVE)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  metadeleted Boolean  @default(false)

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  users                User[]
  user_assignments     BrandUser[]
  accounts_payable     AccountPayable[]
  accounts_receivable  AccountReceivable[]
  transactions         Transaction[]
  ggr_records          GgrDailyRecord[]
  ggr_apurations       GgrMonthlyApuration[]
  data_sources         DataSource[]
  contacts             Contact[] @relation("ContactBrand")
  journal_entries      JournalEntry[]
  fiscal_documents     FiscalDocument[] @relation("FiscalDocBrand")

  @@index([metadeleted])
  @@index([company_id])
  @@map("brands")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entity_id String?
  metadata  Json?
  timestamp DateTime @default(now())

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id])

  @@index([entity, entity_id])
  @@index([user_id])
  @@index([timestamp])
  @@map("audit_logs")
}

// =================== CONTATOS ===================

model Contact {
  id          String            @id @default(cuid())
  person_type ContactPersonType
  name        String
  trade_name  String?
  document    String?
  email       String?
  phone       String?

  address      String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?           @db.VarChar(2)
  zip_code     String?

  is_customer Boolean @default(false)
  is_supplier Boolean @default(false)
  is_employee Boolean @default(false)
  is_partner  Boolean @default(false)

  employee_role             String?
  employee_salary           BigInt?
  employee_base_salary      BigInt?
  employee_variable_salary  BigInt?
  employee_admission_date   DateTime?
  employee_dismissal_date   DateTime?

  partner_share_percentage Decimal? @db.Decimal(5, 2)

  notes       String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  metadeleted Boolean  @default(false)

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  brand_id String?
  brand    Brand?  @relation("ContactBrand", fields: [brand_id], references: [id])

  payables_as_supplier    AccountPayable[]    @relation("ContactSupplier")
  receivables_as_customer AccountReceivable[] @relation("ContactCustomer")

  @@index([metadeleted])
  @@index([company_id])
  @@index([is_customer])
  @@index([is_supplier])
  @@index([is_employee])
  @@map("contacts")
}

// =================== BANCOS ===================

model Bank {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  ispb        String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  metadeleted Boolean  @default(false)

  bank_accounts BankAccount[]

  @@index([metadeleted])
  @@map("banks")
}

// =================== FINANCEIRO ===================

model ChartOfAccount {
  id          String      @id @default(cuid())
  code        String
  name        String
  type        AccountType
  description String?
  parent_id   String?
  parent      ChartOfAccount?  @relation("AccountHierarchy", fields: [parent_id], references: [id])
  children    ChartOfAccount[] @relation("AccountHierarchy")
  is_active   Boolean     @default(true)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  metadeleted Boolean     @default(false)

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  payables    AccountPayable[]
  receivables AccountReceivable[]
  transactions Transaction[]
  journal_lines JournalEntryLine[]

  @@unique([company_id, code])
  @@index([metadeleted])
  @@index([company_id])
  @@map("chart_of_accounts")
}

model FinancialCategory {
  id          String       @id @default(cuid())
  name        String
  type        CategoryType
  color       String?
  description String?
  is_active   Boolean      @default(true)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  metadeleted Boolean      @default(false)

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  // Natureza contábil padrão sugerida quando esta categoria é usada num
  // lançamento. Não impede o usuário de escolher outra natureza, mas
  // pré-popula o campo no formulário, vinculando categoria à DRE.
  default_nature_id String?
  default_nature    FinancialNature? @relation("CategoryDefaultNature", fields: [default_nature_id], references: [id])

  payables    AccountPayable[]
  receivables AccountReceivable[]
  transactions Transaction[]

  @@index([metadeleted])
  @@index([company_id])
  @@index([default_nature_id])
  @@map("financial_categories")
}

// === NOVA ENTIDADE: Natureza Contábil (estrutura DRE) ===
//
// A Natureza define EM QUAL LINHA da DRE o lançamento aparece.
// Exemplo:
//   - "Salários e Encargos" → DESPESA_OPERACIONAL → ordem 1
//   - "Aluguel" → DESPESA_OPERACIONAL → ordem 2
//   - "Marketing" → DESPESA_OPERACIONAL → ordem 3
//
// Diferente da Categoria (que é flexível e visual), a Natureza é estrutural
// e segue o padrão contábil de DRE.
model FinancialNature {
  id   String @id @default(cuid())
  name String

  type        NatureType    // RECEITA ou DESPESA
  dre_section DreSection    // onde aparece na DRE
  dre_order   Int           @default(0)  // ordem dentro da seção da DRE

  description String? @db.Text
  is_default  Boolean @default(false)  // criada pelo seed (padrão sistema)
  is_active   Boolean @default(true)

  // Códigos contábeis (opcionais, para escritórios contábeis avançados)
  accounting_code String?

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  metadeleted Boolean  @default(false)

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  payables    AccountPayable[]
  receivables AccountReceivable[]
  // Categorias que usam essa natureza como padrão (auto-preenchimento)
  default_for_categories FinancialCategory[] @relation("CategoryDefaultNature")

  @@index([metadeleted])
  @@index([company_id])
  @@index([type])
  @@index([dre_section])
  @@map("financial_natures")
}

model BankAccount {
  id              String          @id @default(cuid())
  name            String
  type            BankAccountType
  bank_name       String?
  bank_code       String?
  agency          String?
  account_number  String?
  initial_balance BigInt          @default(0)
  current_balance BigInt          @default(0)
  description     String?
  is_active       Boolean         @default(true)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  metadeleted     Boolean         @default(false)

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  bank_id String?
  bank    Bank?   @relation(fields: [bank_id], references: [id])

  // Vínculo com conexão Open Finance (Pluggy etc.). Conta capturada do provedor.
  bank_connection_id   String?
  bank_connection      BankConnection? @relation(fields: [bank_connection_id], references: [id])
  // ID da conta no provedor (Pluggy accountId) — usado para sync incremental.
  provider_account_id  String?

  // Flag para auditoria de segregação: marca contas que custodiam dinheiro
  // dos apostadores (Lei 14.790 art. 5º). O saldo dessas contas tem que bater
  // com depósitos/saques registrados pelo sistema de apostas.
  is_player_wallet Boolean @default(false)

  // Taxas contratadas com o banco (em centavos por transação).
  // Usadas pela auditoria de tarifas: quantidade de depósitos × fee_per_credit
  // + quantidade de saques × fee_per_debit = tarifas esperadas no período.
  fee_per_credit BigInt @default(0)
  fee_per_debit  BigInt @default(0)

  transactions       Transaction[] @relation("AccountTransactions")
  transfers_received Transaction[] @relation("TransferDestination")
  statements         BankStatement[]

  @@index([metadeleted])
  @@index([company_id])
  @@index([bank_connection_id])
  @@map("bank_accounts")
}

model AccountPayable {
  id              String        @id @default(cuid())
  description     String
  supplier_name   String?
  supplier_doc    String?
  document_number String?
  amount          BigInt
  paid_amount     BigInt        @default(0)
  issue_date      DateTime
  due_date        DateTime
  payment_date    DateTime?
  status          PaymentStatus @default(PENDING)
  notes           String?       @db.Text
  is_recurring    Boolean       @default(false)

  is_deductible_expense       Boolean @default(true)
  generates_pis_cofins_credit Boolean @default(false)
  pis_credit_amount    BigInt @default(0)
  cofins_credit_amount BigInt @default(0)

  // === Retenções federais (CSRF) — serviços tomados de PJ ===
  // Quando is_service_from_pj=true, a fonte pagadora retém na fonte:
  //   IRRF 1,5%  (Lei 9.430/96 art. 647)
  //   CSLL 1,0%  +
  //   PIS  0,65% +  CSRF (IN RFB 459/04)
  //   COFINS 3,0% (total CSRF = 6,15%)
  // O valor LÍQUIDO pago ao fornecedor = amount - (4 retenções).
  // As retenções viram obrigação de DARF (ainda fora deste MVP — fase 2).
  is_service_from_pj Boolean @default(false)
  irrf_retained      BigInt  @default(0)
  csll_retained      BigInt  @default(0)
  pis_retained       BigInt  @default(0)
  cofins_retained    BigInt  @default(0)

  source           PayableSource @default(MANUAL)
  duplicate_of_id  String?
  duplicate_of     AccountPayable?  @relation("PayableDuplicates", fields: [duplicate_of_id], references: [id])
  duplicates       AccountPayable[] @relation("PayableDuplicates")

  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  metadeleted     Boolean       @default(false)

  company_id  String
  company     Company  @relation(fields: [company_id], references: [id])
  brand_id    String?
  brand       Brand?   @relation(fields: [brand_id], references: [id])

  contact_id String?
  contact    Contact? @relation("ContactSupplier", fields: [contact_id], references: [id])

  category_id String?
  category    FinancialCategory? @relation(fields: [category_id], references: [id])

  // === NOVO: vinculação com Natureza Contábil ===
  nature_id String?
  nature    FinancialNature? @relation(fields: [nature_id], references: [id])

  account_id  String?
  account     ChartOfAccount? @relation(fields: [account_id], references: [id])

  ggr_apuration_id String?
  ggr_apuration    GgrMonthlyApuration? @relation(fields: [ggr_apuration_id], references: [id])

  irpj_apuration_id String?
  irpj_apuration    IrpjCsllApuration? @relation(fields: [irpj_apuration_id], references: [id])

  pis_cofins_apuration_id String?
  pis_cofins_apuration    PisCofinsApuration? @relation(fields: [pis_cofins_apuration_id], references: [id])

  iss_apuration_id String?
  iss_apuration    IssApuration? @relation(fields: [iss_apuration_id], references: [id])

  transactions Transaction[]
  fiscal_documents FiscalDocument[] @relation("PayableFiscalDocs")

  @@index([metadeleted])
  @@index([company_id])
  @@index([status])
  @@index([due_date])
  @@index([is_deductible_expense])
  @@index([generates_pis_cofins_credit])
  @@index([nature_id])
  @@index([source])
  @@index([duplicate_of_id])
  @@index([is_service_from_pj])
  @@map("accounts_payable")
}

model AccountReceivable {
  id              String        @id @default(cuid())
  description     String
  customer_name   String?
  customer_doc    String?
  document_number String?
  amount          BigInt
  received_amount BigInt        @default(0)
  issue_date      DateTime
  due_date        DateTime
  receipt_date    DateTime?
  status          PaymentStatus @default(PENDING)
  notes           String?       @db.Text
  is_recurring    Boolean       @default(false)

  revenue_type    RevenueType   @default(NON_OPERATIONAL)

  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  metadeleted     Boolean       @default(false)

  company_id  String
  company     Company  @relation(fields: [company_id], references: [id])
  brand_id    String?
  brand       Brand?   @relation(fields: [brand_id], references: [id])

  contact_id String?
  contact    Contact? @relation("ContactCustomer", fields: [contact_id], references: [id])

  category_id String?
  category    FinancialCategory? @relation(fields: [category_id], references: [id])

  // === NOVO: vinculação com Natureza Contábil ===
  nature_id String?
  nature    FinancialNature? @relation(fields: [nature_id], references: [id])

  account_id  String?
  account     ChartOfAccount? @relation(fields: [account_id], references: [id])

  transactions Transaction[]
  fiscal_documents FiscalDocument[] @relation("ReceivableFiscalDocs")

  @@index([metadeleted])
  @@index([company_id])
  @@index([status])
  @@index([due_date])
  @@index([nature_id])
  @@index([revenue_type])
  @@map("accounts_receivable")
}

model Transaction {
  id          String          @id @default(cuid())
  description String
  amount      BigInt
  type        TransactionType
  date        DateTime
  notes       String?         @db.Text
  reference   String?
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt
  metadeleted Boolean         @default(false)

  company_id String
  company    Company @relation(fields: [company_id], references: [id])
  brand_id   String?
  brand      Brand?  @relation(fields: [brand_id], references: [id])

  bank_account_id String
  bank_account    BankAccount @relation("AccountTransactions", fields: [bank_account_id], references: [id])

  destination_account_id String?
  destination_account    BankAccount? @relation("TransferDestination", fields: [destination_account_id], references: [id])

  category_id String?
  category    FinancialCategory? @relation(fields: [category_id], references: [id])

  account_id  String?
  account     ChartOfAccount? @relation(fields: [account_id], references: [id])

  payable_id    String?
  payable       AccountPayable? @relation(fields: [payable_id], references: [id])
  receivable_id String?
  receivable    AccountReceivable? @relation(fields: [receivable_id], references: [id])

  statement_lines BankStatementLine[]

  @@index([metadeleted])
  @@index([company_id])
  @@index([date])
  @@index([bank_account_id])
  @@map("transactions")
}

model BankStatement {
  id              String          @id @default(cuid())
  filename        String
  file_format     String
  start_date      DateTime
  end_date        DateTime
  initial_balance BigInt?
  final_balance   BigInt?
  status          StatementStatus @default(PROCESSING)
  total_lines     Int             @default(0)
  matched_lines   Int             @default(0)
  notes           String?         @db.Text
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  metadeleted     Boolean         @default(false)

  company_id String
  company    Company @relation(fields: [company_id], references: [id])

  bank_account_id String
  bank_account    BankAccount @relation(fields: [bank_account_id], references: [id])

  lines BankStatementLine[]

  @@index([metadeleted])
  @@index([company_id])
  @@index([bank_account_id])
  @@map("bank_statements")
}

model BankStatementLine {
